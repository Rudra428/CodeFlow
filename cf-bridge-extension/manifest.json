{
  "manifest_version": 3,
  "name": "CodeFlow",
  "version": "1.0.1",
  "description": "Load Codeforces, AtCoder, and CSES samples into CodeFlow and submit through your browser session.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/codeflow-16.png",
    "32": "icons/codeflow-32.png",
    "48": "icons/codeflow-48.png",
    "128": "icons/codeflow-128.png"
  },
  "host_permissions": [
    "https://codeforces.com/*",
    "https://www.codeforces.com/*",
    "https://atcoder.jp/*",
    "https://www.atcoder.jp/*",
    "https://cses.fi/*",
    "https://www.cses.fi/*",
    "https://code-flow-rho-lemon.vercel.app/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open problem in CodeFlow",
    "default_icon": {
      "16": "icons/codeflow-16.png",
      "32": "icons/codeflow-32.png",
      "48": "icons/codeflow-48.png",
      "128": "icons/codeflow-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://code-flow-rho-lemon.vercel.app/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
